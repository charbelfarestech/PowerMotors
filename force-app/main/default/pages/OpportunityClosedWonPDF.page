<!-- PDF template rendered after an Opportunity transitions to Closed Won. -->
<apex:page renderAs="pdf" controller="OpportunityClosedWonPDFController" applyHtmlTag="false" showHeader="false">
    <head>
        <style>
            @page {
                size: letter;
                margin: 0.5in;
                @bottom-right {
                    content: "Page " counter(page) " of " counter(pages);
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #555;
                }
            }
            body {
                font-family: Arial, sans-serif;
                color: #333;
                font-size: 13px;
                line-height: 1.4;
            }
            .header-title {
                font-size: 26px;
                color: #000;
                margin-bottom: 30px;
            }
            .info-table {
                width: 100%;
                margin-bottom: 25px;
                border-collapse: collapse;
            }
            .info-table td {
                padding: 4px 0;
                border: none;
                vertical-align: top;
            }
            .label {
                color: #555;
                width: 18%;
            }
            .value {
                color: #000;
                width: 32%;
            }
            .line-items-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 20px;
            }
            .line-items-table th {
                background-color: #7f7f7f;
                color: #fff;
                padding: 8px 10px;
                font-weight: normal;
                text-align: left;
                font-size: 13px;
            }
            .line-items-table td {
                padding: 8px 10px;
                border: 1px solid #ccc;
                border-top: none;
                border-bottom: none;
            }
            .line-items-table tr:last-child td {
                border-bottom: 1px solid #ccc;
            }
            .text-right { text-align: right; }
            .text-center { text-align: center; }
            .summary-container {
                width: 100%;
                margin-top: 15px;
                margin-bottom: 40px;
            }
            .summary-table {
                float: right;
                width: 40%;
                border-collapse: collapse;
            }
            .summary-table td {
                padding: 4px 10px;
                border: none;
            }
            .clear { clear: both; }
            .section-header {
                background-color: #e2e7ee;
                color: #333;
                padding: 6px 10px;
                font-weight: normal;
                font-size: 14px;
                margin-bottom: 15px;
            }
            .signature-table {
                width: 100%;
                margin-top: 10px;
            }
            .signature-table td {
                padding: 12px 0;
                border: none;
                vertical-align: bottom;
            }
            .signature-line {
                border-bottom: 1px solid #666;
                width: 70%;
            }
        </style>
    </head>
    <body>
        <div class="header-title">Power Motors</div>

        <table class="info-table">
            <tr>
                <td class="label">Opportunity Name</td>
                <td class="value"><apex:outputText value="{!opp.Name}"/></td>
                <td class="label">Close Date</td>
                <td class="value">
                    <apex:outputText value="{0,date,M/d/yyyy}">
                        <apex:param value="{!opp.CloseDate}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td class="label">Account</td>
                <td class="value"><apex:outputText value="{!opp.Account.Name}"/></td>
                <td class="label">Stage</td>
                <td class="value"><apex:outputText value="{!opp.StageName}"/></td>
            </tr>
            <tr>
                <td class="label">Prepared By</td>
                <td class="value"><apex:outputText value="{!opp.Owner.Name}"/></td>
                <td class="label">Owner Email</td>
                <td class="value"><apex:outputText value="{!opp.Owner.Email}"/></td>
            </tr>
        </table>

        <table class="line-items-table">
            <thead>
                <tr>
                    <th style="width: 40%;">Product / Description</th>                
                    <th class="text-right" style="width: 15%;">Sales Price</th>
                    <th class="text-center" style="width: 10%;">Quantity</th>
                    <th class="text-right" style="width: 20%;">Total Price</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><apex:outputText value="{!opp.Description}"/></td>
                    <td class="text-right">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!opp.Amount}" />
                        </apex:outputText>
                    </td>
                    <td class="text-center">1.00</td>
                    <td class="text-right">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!opp.Amount}" />
                        </apex:outputText>
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="summary-container">
            <table class="summary-table">
                <tr>
                    <td>Subtotal</td>
                    <td class="text-right">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!opp.Amount}" />
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td>Total Price</td>
                    <td class="text-right" style="font-weight: bold;">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!opp.Amount}" />
                        </apex:outputText>
                    </td>
                </tr>
            </table>
        </div>
        <div class="clear"></div>

        <div class="section-header">Opportunity Acceptance Information</div>
        <table class="signature-table">
            <tr>
                <td style="width: 15%;">Signature</td>
                <td class="signature-line"></td>
            </tr>
            <tr>
                <td>Name</td>
                <td class="signature-line"></td>
            </tr>
            <tr>
                <td>Title</td>
                <td class="signature-line"></td>
            </tr>
            <tr>
                <td>Date</td>
                <td class="signature-line"></td>
            </tr>
        </table>
    </body>
</apex:page>
